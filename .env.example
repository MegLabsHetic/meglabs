# Copie ce fichier en `.env` et renseigne tes valeurs. `.env` est gitignore.
# Aucune vraie cle ne doit jamais apparaitre dans ce fichier.

# --- Fournisseurs LLM -------------------------------------------------------
# Au moins un fournisseur doit etre configure. Le routing tache -> modele vit
# dans backend/app/core/config.py (MODEL_ROUTING), jamais en dur dans un agent.
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Base de donnees --------------------------------------------------------
# SQLite en POC. Ne jamais coupler le code au dialecte SQLite : migration
# PostgreSQL prevue (il suffira de changer cette URL).
DATABASE_URL=sqlite+aiosqlite:///./meglabs.db

# --- Backend ----------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
STORAGE_DIR=./storage

# Origines autorisees a appeler l'API depuis un navigateur, separees par des virgules.
# DOIT contenir l'adresse exacte du frontend, port compris. Si elle manque, le
# navigateur bloque les appels et l'interface affiche une erreur reseau alors que le
# serveur repond parfaitement — le symptome ne designe pas la cause.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Ports publies ----------------------------------------------------------
# A changer si un port est deja pris sur la machine. Pensez alors a ajouter la
# nouvelle adresse du front dans CORS_ORIGINS ci-dessus.
FRONTEND_PORT=3000
BACKEND_PORT=8000

# --- Limites (appliquees cote backend, cf. regle d'architecture 6) ----------
MAX_FILE_SIZE_MB=100
MAX_ROWS=1000000
MIN_ROWS_FOR_ML=50
MAX_SQL_RESULT_ROWS=500
DUCKDB_TIMEOUT_SECONDS=30

# --- Frontend ---------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
