# Copie en `deploy/.env.prod`. Reglages du backend de production.
# Aucune vraie cle ne doit apparaitre dans ce fichier d'exemple.

LLM_PROVIDER=scaleway
SCALEWAY_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
SCALEWAY_BASE_URL=https://api.scaleway.ai/<project-id>/v1

# Le mot de passe doit correspondre a POSTGRES_PASSWORD de deploy/.env.
DATABASE_URL=postgresql+asyncpg://meglabs:MOT_DE_PASSE@postgres:5432/meglabs_prod

APP_ENV=production
LOG_LEVEL=INFO

# Doit contenir l'adresse publique EXACTE du front, protocole compris. Si elle
# manque, le navigateur bloque les appels et l'interface affiche une erreur
# reseau alors que le serveur repond parfaitement.
CORS_ORIGINS=https://faridb.site

# Un million de lignes lues d'abord en texte, ce sont plusieurs gigaoctets de
# DataFrame : de quoi faire tuer un service voisin par le noyau. La valeur reste
# tres au-dessus de tout ce qui sera montre.
MAX_FILE_SIZE_MB=100
MAX_ROWS=200000
MIN_ROWS_FOR_ML=50
MAX_SQL_RESULT_ROWS=500
DUCKDB_TIMEOUT_SECONDS=30
