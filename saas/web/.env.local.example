# URL de l'API Rust
NEXT_PUBLIC_API_URL=http://localhost:8090

# Supabase (auth) — a remplir apres creation du projet Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Mode dev : sans Supabase, l'UI s'authentifie avec cet UUID via x-dev-user-id.
# L'API doit tourner avec AUTH_MODE=dev. Laisser vide en production.
NEXT_PUBLIC_DEV_USER_ID=11111111-1111-1111-1111-111111111111
