# ──────────────────────────────────────────────
# Infra
# ──────────────────────────────────────────────
POSTGRES_PASSWORD=dev_password

# ──────────────────────────────────────────────
# Authentification
#   AUTH_MODE=dev   -> pas de Supabase requis, l'API accepte l'en-tête
#                      x-dev-user-id (UUID) pour simuler un utilisateur.
#   AUTH_MODE=prod  -> l'API vérifie les JWT Supabase (HS256) avec le secret ci-dessous.
# ──────────────────────────────────────────────
#   AUTH_MODE=local -> comptes e-mail + mot de passe geres par l'api
#                      (aucun service externe). AUTH_SECRET obligatoire.
AUTH_MODE=local

# Signature des jetons emis par l'api. OBLIGATOIRE en mode local, 32
# caracteres minimum — l'api refuse de demarrer en dessous.
#   openssl rand -hex 32
AUTH_SECRET=

SUPABASE_JWT_SECRET=

# ──────────────────────────────────────────────
# Frontend (Next.js) — à remplir quand vous créez votre projet Supabase
# ──────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# CORS : origine autorisée à appeler l'API
ALLOWED_ORIGIN=http://localhost:3000

RUST_LOG=info,api=debug
